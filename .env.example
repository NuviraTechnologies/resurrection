# Copy to .env and fill in for LIVE (sandbox) mode.
# With none of these set, the app runs in SIM MODE (no network, all
# simulated calls labeled SIM in the UI and event log).

# PayPal sandbox REST app credentials — https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Live-mode seed: an existing ACTIVE sandbox subscription to suspend and
# recover (see README "Seeding a failed subscription").
RESURRECTION_SUBSCRIPTION_ID=

# Optional AI polish hook for the member recovery message.
# Works fully without either key (deterministic templates).
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Optional server port (default 8080)
PORT=8080
